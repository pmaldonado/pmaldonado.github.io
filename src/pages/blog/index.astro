---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { formatDate, getPosts } from "@/lib/posts";

const posts = await getPosts();
---

<SiteLayout title="Writing · Peter Maldonado" description="Writing by Peter Maldonado." nav>
  <div class="max-w-3xl mx-auto px-6 sm:px-12 mb-12">
    <h1 class="text-5xl md:text-6xl font-normal mb-8 tracking-tight">Writing</h1>
    {
      posts.length === 0 ? (
        <p class="text-2xl leading-snug">Nothing here yet.</p>
      ) : (
        <ul class="space-y-6">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="link-highlight text-2xl">
                {post.data.title}
              </a>
              {post.data.draft && <span class="ml-2 text-sm uppercase tracking-wide text-[#14b8a6]">draft</span>}
              <p class="text-lg opacity-75 mt-1">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {post.data.description}
              </p>
            </li>
          ))}
        </ul>
      )
    }
    <p class="mt-10 text-lg">
      <a href="/rss.xml" class="link-highlight">RSS feed</a>
    </p>
  </div>
</SiteLayout>
